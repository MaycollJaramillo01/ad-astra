{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": { "deploymentEnabled": false },
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist/web",
  "functions": { "api/index.ts": { "maxDuration": 300, "includeFiles": "src/**" } },
  "crons": [{ "path": "/v1/internal/tick", "schedule": "*/5 * * * *" }],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api" },
    { "source": "/((?!api|assets|v1).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; object-src 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
