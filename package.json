{
  "name": "ad-astra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev:api": "node --watch --env-file-if-exists=.env.local src/server.ts",
    "dev:worker": "node --env-file-if-exists=.env.local scripts/worker.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.ts",
    "ops:backup": "node scripts/backup.ts create",
    "ops:restore": "node scripts/backup.ts restore",
    "ops:recovery-drill": "node scripts/recovery-drill.ts",
    "ops:control": "node --env-file-if-exists=.env.local scripts/operations.ts",
    "ops:costs": "node scripts/operating-costs.ts",
    "docs:check": "node scripts/check-docs.ts",
    "spike:meta": "node --env-file-if-exists=.env.local scripts/spike-meta.ts",
    "ai:eval": "node --env-file-if-exists=.env.local scripts/ai-eval.ts",
    "forecast:experiments": "node scripts/forecast-experiments.ts",
    "specs:update": "node scripts/update-meta-specs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@tanstack/react-query": "^5.104.5",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
