# Copia este archivo a .env.local (ignorado por git) y rellena los valores.

# Postgres local de docker compose. Credenciales solo de desarrollo.
DATABASE_URL=postgres://app_rw:app_rw_local@localhost:55432/ad_astra

# Meta: solo para el spike manual autorizado (docs/TESTING.md §9). Nunca en la CI.
META_APP_ID=
META_APP_SECRET=
# Token del usuario del sistema con ads_read
META_ACCESS_TOKEN=
# Opcional: cuenta a analizar (act_123...). Si se omite, se usa la primera accesible.
META_SPIKE_ACCOUNT_ID=
