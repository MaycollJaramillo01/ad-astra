# Copia este archivo a .env.local (ignorado por git) y rellena los valores.
# En Vercel, las mismas variables se definen como "Sensitive" por entorno (ADR-022).

NODE_ENV=development
# workspace (predeterminado) o password (cuentas provisionadas, sin registro público).
AUTH_MODE=workspace
# Origen de la SPA. En local, Vite (5173) reenvía /v1 a la API (3000): mismo origen.
APP_ORIGIN=http://localhost:5173

# Postgres local de docker compose. Credenciales solo de desarrollo.
DATABASE_URL=postgres://app_rw:app_rw_local@localhost:55432/ad_astra
# Rol propietario: solo para pnpm db:migrate (la app nunca lo usa).
DATABASE_URL_OWNER=postgres://app_owner:app_owner_local@localhost:55432/ad_astra

# Secreto de sesiones (mínimo 32 caracteres). Generar: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth "Aplicación web",
# con la pantalla de consentimiento en modo "Internal" (solo cuentas del Workspace).
# URI de redirección autorizada: <APP_ORIGIN>/v1/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominio del Workspace de la agencia, p. ej. agencia.com
GOOGLE_WORKSPACE_DOMAIN=

# Claves de cifrado de tokens de Meta, "versión:clave_base64_32_bytes" separadas por comas.
# Generar: node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEYS=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Meta: app de la agencia. La sincronización y el spike manual autorizado (docs/TESTING.md §9)
# las necesitan; nunca en la CI (los tests usan un Meta simulado).
META_APP_ID=
META_APP_SECRET=
# Solo el spike: token del usuario del sistema con ads_read
META_ACCESS_TOKEN=
# Opcional: cuenta a analizar (act_123...). Si se omite, se usa la primera accesible.
META_SPIKE_ACCOUNT_ID=

# Tick de la cola de trabajos (ADR-022). Vercel Cron lo llama con "Authorization: Bearer $CRON_SECRET".
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
TICK_BUDGET_SECONDS=240
TICK_CONCURRENCY=3

# Action Center: bloqueo global por defecto. Requiere además política por cuenta,
# consentimiento de escritura, preview en vivo y aprobaciones humanas independientes.
META_WRITES_ENABLED=false

# Correo de monitoreo: además requiere política y destinatarios autorizados por cuenta.
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=
NOTIFICATIONS_FROM=

# Asistente de IA (F4). Sin clave, la IA queda desactivada (503) y nunca simula respuestas.
# Nunca en la CI: los tests usan un proveedor guionizado.
ANTHROPIC_API_KEY=
# Alternativa: AI_PROVIDER=nvidia y AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_API_KEY=
# Tasas INTERNAS por millón de tokens para reservas y límites, NO precios de NVIDIA.
# No se presume facturación gratuita ni descuentos de caché. Revisar según el servicio contratado.
NVIDIA_BUDGET_INPUT_USD_PER_MILLION=4
NVIDIA_BUDGET_OUTPUT_USD_PER_MILLION=20
AI_PROVIDER=anthropic
# claude-opus-5-5 (por defecto) o claude-sonnet-5-5
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
# Límites de costo en USD: por organización y mes, por usuario y día, y por pregunta
AI_MONTHLY_BUDGET_USD=100
AI_USER_DAILY_BUDGET_USD=10
AI_QUESTION_BUDGET_USD=1
AI_ASK_PER_MINUTE=10
# Vinculación obligatoria con la base: development / test / staging / production.
APP_ENV=development
# Producción: grupo explícito de tenants para efectos externos durante el despliegue progresivo.
WRITE_TENANT_ALLOWLIST=
# Monitor externo de solo lectura. Separado del secreto de cron.
OPS_MONITOR_SECRET=

# Caché de informes: 15000 ms por defecto en producción; alcance revalidado en cada lectura.
ANALYTICS_CACHE_MS=15000
# Producción exige activación explícita tras validar cobertura con datos reales.
# FORECASTING_ENABLED=false

# Solo tareas operativas, NUNCA variables del runtime de Vercel. Ver docs/OPERATIONS.md.
# BACKUP_DATABASE_URL / RESTORE_DATABASE_URL: roles operativos separados con BYPASSRLS.
# BACKUP_ENCRYPTION_KEY: clave base64 de 32 bytes custodiada fuera del bucket y del repositorio.
# BACKUP_DIRECTORY / BACKUP_ARCHIVE: destino local / archivo .aab para restaurar en una BD vacía.
# BACKUP_EVIDENCE_FILE / BACKUP_RECEIPT_FILE: metadatos y recibo S3 verificados.
# DRILL_EVIDENCE_FILE / RELEASE_EVIDENCE_FILE: atestaciones revisadas (ops/*.example.json).
# OPS_AUDIT_TENANT_ID / OPS_CHANGE_REASON: organización y ticket del cambio operativo.
# LEGACY_WORKERS_STOPPED=true: atestación tras detener workers y drenar llamadas antes de migrar producción.
